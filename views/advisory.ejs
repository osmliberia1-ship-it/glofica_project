<%- include('partials/head') %>
<%- include('partials/header') %>

<!-- Hero Section -->
<section class="relative overflow-hidden bg-gfb-navy">
  <div class="mx-auto max-w-7xl px-4 lg:px-8">
    <div class="grid gap-8 py-16 md:grid-cols-2 md:py-20 lg:py-28">
      <div class="flex flex-col justify-center">
        <p class="mb-4 text-sm font-semibold uppercase tracking-widest text-gfb-gold">Expert Guidance</p>
        <h1 class="font-display text-4xl font-bold leading-tight text-white md:text-5xl lg:text-6xl">
          Comprehensive Strategic Support
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-white/80">
          Our expert advisors provide tailored strategic guidance to help your institution overcome financial integrity challenges and implement lasting systemic reforms.
        </p>
      </div>
      <div class="flex items-center justify-center">
        <img src="/images/membership image 1.jpg" alt="Advisory Team" class="h-full w-full rounded-xl object-cover shadow-2xl">
      </div>
    </div>
  </div>
</section>

<!-- Key Differentiators Section -->
<section class="bg-gfb-cream py-20">
  <div class="mx-auto max-w-7xl px-4 lg:px-8">
    <h2 class="section-heading text-center">Why Choose GFB Advisory?</h2>
    <p class="section-subheading mx-auto text-center">
      We combine deep financial expertise with practical implementation experience across 15+ countries.
    </p>
    <div class="mt-14 grid gap-8 md:grid-cols-3">
      <div class="rounded-xl bg-white p-8 shadow-sm">
        <h3 class="text-lg font-bold text-gfb-teal">Client Advocacy</h3>
        <p class="mt-3 text-sm leading-relaxed text-gfb-slate">We put your institution's goals first, developing customized solutions that align with your specific context and constraints.</p>
      </div>
      <div class="rounded-xl bg-white p-8 shadow-sm">
        <h3 class="text-lg font-bold text-gfb-teal">Risk Analysis & Strategy</h3>
        <p class="mt-3 text-sm leading-relaxed text-gfb-slate">Comprehensive assessment of financial vulnerabilities with actionable strategies for mitigation and reform.</p>
      </div>
      <div class="rounded-xl bg-white p-8 shadow-sm">
        <h3 class="text-lg font-bold text-gfb-teal">Ongoing Guidance</h3>
        <p class="mt-3 text-sm leading-relaxed text-gfb-slate">Long-term advisory partnership to support implementation, monitor progress, and adapt strategies as needed.</p>
      </div>
    </div>
  </div>
</section>

<!-- Our Approach Section -->
<section class="bg-white py-20">
  <div class="mx-auto max-w-7xl px-4 lg:px-8">
    <div class="grid gap-12 md:grid-cols-2">
      <div class="flex flex-col justify-center">
        <h2 class="text-3xl font-bold text-gfb-navy md:text-4xl">Our Advisory Approach</h2>
        <p class="mt-4 text-lg text-gfb-slate">
          We follow a structured methodology to ensure your institution receives comprehensive, actionable guidance at every stage.
        </p>
        <ul class="mt-8 space-y-4">
          <li class="flex gap-3">
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-gfb-teal text-white font-bold">1</span>
            <div>
              <h4 class="font-bold text-gfb-navy">Assessment & Diagnostics</h4>
              <p class="text-sm text-gfb-slate">Deep-dive analysis of your current financial systems and vulnerability landscape.</p>
            </div>
          </li>
          <li class="flex gap-3">
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-gfb-teal text-white font-bold">2</span>
            <div>
              <h4 class="font-bold text-gfb-navy">Strategy Development</h4>
              <p class="text-sm text-gfb-slate">Tailored reform roadmap with prioritized interventions and implementation timelines.</p>
            </div>
          </li>
          <li class="flex gap-3">
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-gfb-teal text-white font-bold">3</span>
            <div>
              <h4 class="font-bold text-gfb-navy">Implementation Support</h4>
              <p class="text-sm text-gfb-slate">Hands-on guidance during policy development, system setup, and operational launch.</p>
            </div>
          </li>
        </ul>
      </div>
      <div class="flex items-center justify-center">
        <img src="/images/membership image 2.jpg" alt="Advisory Process" class="w-full rounded-xl object-cover shadow-lg">
      </div>
    </div>
  </div>
</section>

<!-- Request Form Section -->
<section class="bg-gfb-cream py-20">
  <div class="mx-auto max-w-2xl px-4 lg:px-8">
    <h2 class="section-heading text-center">Request Advisory Support</h2>
    <p class="section-subheading mx-auto text-center">
      Tell us about your institution's goals and challenges. Our advisory team will respond within 2 business days.
    </p>
    <form class="mt-12 rounded-2xl bg-white p-8 shadow-sm" action="#" method="post">
      <div class="grid gap-6 sm:grid-cols-2">
        <div>
          <label for="name" class="block text-sm font-medium text-gfb-navy">Full Name</label>
          <input type="text" id="name" name="name" required class="mt-1 w-full rounded-md border border-gfb-navy/20 px-4 py-2.5 text-sm focus:border-gfb-teal focus:outline-none focus:ring-1 focus:ring-gfb-teal">
        </div>
        <div>
          <label for="email" class="block text-sm font-medium text-gfb-navy">Email Address</label>
          <input type="email" id="email" name="email" required class="mt-1 w-full rounded-md border border-gfb-navy/20 px-4 py-2.5 text-sm focus:border-gfb-teal focus:outline-none focus:ring-1 focus:ring-gfb-teal">
        </div>
      </div>
      <div class="mt-6">
        <label for="institution" class="block text-sm font-medium text-gfb-navy">Institution / Organization</label>
        <input type="text" id="institution" name="institution" required class="mt-1 w-full rounded-md border border-gfb-navy/20 px-4 py-2.5 text-sm focus:border-gfb-teal focus:outline-none focus:ring-1 focus:ring-gfb-teal">
      </div>
      <div class="mt-6">
        <label for="membership-type" class="block text-sm font-medium text-gfb-navy">Membership Interest</label>
        <select id="membership-type" name="membership-type" class="mt-1 w-full rounded-md border border-gfb-navy/20 px-4 py-2.5 text-sm focus:border-gfb-teal focus:outline-none focus:ring-1 focus:ring-gfb-teal">
          <option value="government">Government Membership</option>
          <option value="institutional">Institutional &amp; Partner</option>
          <option value="open">Open Access</option>
          <option value="advisory">General Advisory Support</option>
        </select>
      </div>
      <div class="mt-6">
        <label for="message" class="block text-sm font-medium text-gfb-navy">Brief Overview of Goals and Challenges</label>
        <textarea id="message" name="message" rows="5" required class="mt-1 w-full rounded-md border border-gfb-navy/20 px-4 py-2.5 text-sm focus:border-gfb-teal focus:outline-none focus:ring-1 focus:ring-gfb-teal"></textarea>
      </div>
      <button type="submit" class="btn-primary mt-8 w-full">Submit Application</button>
    </form>
  </div>
</section>

<!-- CTA Section -->
<section class="bg-gfb-navy py-20">
  <div class="mx-auto max-w-7xl px-4 text-center lg:px-8">
    <h2 class="text-3xl font-bold text-white md:text-4xl">Ready for Transformative Advisory Support?</h2>
    <p class="mt-4 max-w-2xl text-lg text-white/80">
      Our advisors are standing by to discuss your institution's unique needs and opportunities.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-4">
      <a href="#" class="btn-primary">Schedule a Consultation</a>
      <a href="/membership" class="btn-outline">Explore Membership</a>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
