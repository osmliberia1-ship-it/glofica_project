<%- include('partials/head') %>
<%- include('partials/header') %>

<section class="bg-gfb-navy py-16">
  <div class="mx-auto max-w-7xl px-4 lg:px-8">
    <h1 class="font-display text-4xl font-bold text-white md:text-5xl">Request Advisory Support</h1>
    <p class="mt-4 max-w-2xl text-lg text-white/70">
      Tell us about your institution's goals and challenges. Our advisory team will respond within 2 business days.
    </p>
  </div>
</section>

<section class="bg-gfb-cream py-20">
  <div class="mx-auto max-w-2xl px-4 lg:px-8">
    <form class="rounded-2xl bg-white p-8 shadow-sm" action="#" method="post">
      <div class="grid gap-6 sm:grid-cols-2">
        <div>
          <label for="name" class="block text-sm font-medium text-gfb-navy">Full Name</label>
          <input type="text" id="name" name="name" required class="mt-1 w-full rounded-md border border-gfb-navy/20 px-4 py-2.5 text-sm focus:border-gfb-teal focus:outline-none focus:ring-1 focus:ring-gfb-teal">
        </div>
        <div>
          <label for="email" class="block text-sm font-medium text-gfb-navy">Email Address</label>
          <input type="email" id="email" name="email" required class="mt-1 w-full rounded-md border border-gfb-navy/20 px-4 py-2.5 text-sm focus:border-gfb-teal focus:outline-none focus:ring-1 focus:ring-gfb-teal">
        </div>
      </div>
      <div class="mt-6">
        <label for="institution" class="block text-sm font-medium text-gfb-navy">Institution / Organization</label>
        <input type="text" id="institution" name="institution" required class="mt-1 w-full rounded-md border border-gfb-navy/20 px-4 py-2.5 text-sm focus:border-gfb-teal focus:outline-none focus:ring-1 focus:ring-gfb-teal">
      </div>
      <div class="mt-6">
        <label for="membership-type" class="block text-sm font-medium text-gfb-navy">Membership Interest</label>
        <select id="membership-type" name="membership-type" class="mt-1 w-full rounded-md border border-gfb-navy/20 px-4 py-2.5 text-sm focus:border-gfb-teal focus:outline-none focus:ring-1 focus:ring-gfb-teal">
          <option value="government">Government Membership</option>
          <option value="institutional">Institutional &amp; Partner</option>
          <option value="open">Open Access</option>
          <option value="advisory">General Advisory Support</option>
        </select>
      </div>
      <div class="mt-6">
        <label for="message" class="block text-sm font-medium text-gfb-navy">Brief Overview of Goals and Challenges</label>
        <textarea id="message" name="message" rows="5" required class="mt-1 w-full rounded-md border border-gfb-navy/20 px-4 py-2.5 text-sm focus:border-gfb-teal focus:outline-none focus:ring-1 focus:ring-gfb-teal"></textarea>
      </div>
      <button type="submit" class="btn-primary mt-8 w-full">Submit Application</button>
    </form>
  </div>
</section>

<%- include('partials/footer') %>
