  </div>
</section>

<!-- CTA Section -->
<section class="bg-white py-20">
  <div class="mx-auto max-w-7xl px-4 text-center lg:px-8">
    <h2 class="section-heading">Stay Updated on Events and Knowledge</h2>
    <p class="section-subheading mx-auto">
      Subscribe to our newsletter to receive updates on upcoming events, latest research, and policy insights.
    </p>
    <div class="mt-10 flex flex-wrap justify-center gap-4">
      <a href="/login" class="btn-primary">Sign Up for Open Access</a>
      <a href="/membership" class="btn-outline-dark">Explore Membership</a>
    </div>
  </div>
</section>

