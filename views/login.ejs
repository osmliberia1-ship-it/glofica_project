<%- include('partials/head') %>
<%- include('partials/header') %>

<section class="bg-gfb-navy py-16">
  <div class="mx-auto max-w-7xl px-4 lg:px-8">
    <h1 class="font-display text-4xl font-bold text-white md:text-5xl">Member Login</h1>
    <p class="mt-4 max-w-2xl text-lg text-white/70">
      Access your GFB member dashboard, research library, and monitoring tools.
    </p>
  </div>
</section>

<section class="bg-gfb-cream py-20">
  <div class="mx-auto max-w-md px-4 lg:px-8">
    <form class="rounded-2xl bg-white p-8 shadow-sm" action="#" method="post">
      <div>
        <label for="login-email" class="block text-sm font-medium text-gfb-navy">Email Address</label>
        <input type="email" id="login-email" name="email" required class="mt-1 w-full rounded-md border border-gfb-navy/20 px-4 py-2.5 text-sm focus:border-gfb-teal focus:outline-none focus:ring-1 focus:ring-gfb-teal">
      </div>
      <div class="mt-6">
        <label for="password" class="block text-sm font-medium text-gfb-navy">Password</label>
        <input type="password" id="password" name="password" required class="mt-1 w-full rounded-md border border-gfb-navy/20 px-4 py-2.5 text-sm focus:border-gfb-teal focus:outline-none focus:ring-1 focus:ring-gfb-teal">
      </div>
      <button type="submit" class="btn-primary mt-8 w-full">Sign In</button>
      <p class="mt-6 text-center text-sm text-gfb-slate">
        Don't have an account?
        <a href="/membership" class="font-semibold text-gfb-teal hover:underline">Explore Membership</a>
      </p>
    </form>
  </div>
</section>

<%- include('partials/footer') %>
